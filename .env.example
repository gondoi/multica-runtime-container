# Optional non-secret knobs for compose/laptop. Tokens prefer Secret file mounts
# under ./secrets/ (see examples/secrets/). Env values still override files when set.
#
# Daemon Ready requires Multica auth + git auth (GitHub App trio, static forge
# token, or GHES username + password — from files and/or env; GitHub tiers
# resolve App > PAT > password) and every agent CLI harness named by
# MULTICA_AGENT_CLI (default: cursor → CURSOR_API_KEY).

# Agent CLI harnesses this container provisions/gates, comma separated:
#   cursor | claude | cursor,claude
# The harness used for a specific run is chosen on the Multica agent definition
# (server side); this only guarantees the CLI is installed and authenticated
# here. Default cursor keeps the pre-Claude boot contract.
MULTICA_AGENT_CLI=cursor

# Multica (optional when secrets/multica-home/config.json is projected)
# MULTICA_TOKEN=
MULTICA_SERVER_URL=https://api.multica.ai
MULTICA_APP_URL=https://multica.ai
# Preferred: slug, display name, or UUID. Applied AFTER login (login can clobber).
# MULTICA_WORKSPACE=fuel-labs
# Legacy alias (same resolution as MULTICA_WORKSPACE):
MULTICA_WORKSPACE_ID=
# Runtime-list display name. Multica names each runtime "<Provider> (<machine
# name>)" — e.g. "Cursor (fuel-general)" / "Claude (fuel-general)" — so use something
# that describes the
# scope/permissions of this deployment (fuel-general, fuel-mutate, personal).
# Unset = container hostname (the pod name under Kubernetes). Native CLI alias:
# MULTICA_DAEMON_DEVICE_NAME (set only one — differing values are a hard boot error).
# MULTICA_MACHINE_NAME=fuel-general
#
# MULTICA_AGENT_RUNTIME_NAME does NOT set that display name (CLI 0.8.0 ignores
# --runtime-name for built-in providers); it stays the daemon's fallback id.
MULTICA_AGENT_RUNTIME_NAME=multica-runtime
# MULTICA_DAEMON_ID is normally secrets/multica-home/daemon.id

# Cursor / git — prefer files under secrets/; env override is supported:
# CURSOR_API_KEY=
#
# Claude Code harness (only gated when MULTICA_AGENT_CLI includes claude).
# Provide ONE of these — API key, OAuth token from `claude setup-token`, or a
# gateway bearer token (pair with ANTHROPIC_BASE_URL):
# ANTHROPIC_API_KEY=
# CLAUDE_CODE_OAUTH_TOKEN=
# ANTHROPIC_AUTH_TOKEN=
# ANTHROPIC_BASE_URL=                 # optional gateway/proxy endpoint
#
# Git — prefer files under secrets/; env override is supported:
# GITHUB_TOKEN=                      # PAT path (personal / org that allows PATs)
# GITLAB_TOKEN=
# GITLAB_HOST=gitlab.com
# GITEA_TOKEN=
# GITEA_HOST=
# GITEA_USER=oauth2
#
# GitHub App path (preferred for orgs that ban PATs; no branch-protection bypass):
# GITHUB_APP_ID=
# GITHUB_APP_INSTALLATION_ID=
# GITHUB_APP_PRIVATE_KEY=            # PEM (prefer secrets/git/GITHUB_APP_PRIVATE_KEY file)
# GITHUB_APP_PRIVATE_KEY_FILE=/run/secrets/git/GITHUB_APP_PRIVATE_KEY
#
# GitHub host for all three GitHub tiers (default github.com). Set to a GitHub
# Enterprise Server host to use the username+password tier:
# GITHUB_HOST=ghe.example.com
#
# GitHub Enterprise Server password tier (lowest priority; github.com rejects it):
# GITHUB_USER=
# GITHUB_PASSWORD=
#
# Force one GitHub tier instead of automatic precedence App > PAT > password
# (a forced tier that is incomplete is a hard boot error):
# GITHUB_AUTH_TIER=token

# Configurable workspaces root (PVC / compose volume mount point)
MULTICA_WORKSPACES_ROOT=/home/agent/workspaces

# AWS CLI — the image ships `aws` with NO credentials of its own. Prefer, in
# order: IRSA (EKS ServiceAccount annotation) > instance/task role > a mounted
# config file / aws-sso ConfigMaps. See README "AWS CLI auth tiers". Nothing
# below is required when the host/pod already has a role attached.
# AWS_REGION=us-east-1
# AWS_DEFAULT_REGION=us-east-1
# Tier 3 fallback only (bind-mount secrets/aws first, see docs/docker.md):
# AWS_CONFIG_FILE=/run/secrets/aws/config
# AWS_SHARED_CREDENTIALS_FILE=/run/secrets/aws/credentials
# Never put AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY here — env keys win the
# SDK chain, skip the rotation/least-privilege of a role, and leak into
# `docker inspect`. Use a role or a mounted file.
#
# aws-sso ConfigMaps (homelab / compose without IRSA): do NOT set AWS_PROFILE.
# Mount examples/aws (or a private allowlist) at
#   /run/config/aws/config and /run/config/aws-sso/config.yaml
# Operator SSO login only:
#   AWS_SSO_OPERATOR_LOGIN=1 aws-sso login --url-action=print
# AWS_SSO_OPERATOR_LOGIN=

# Daemon log level shown on container stdout: DEBUG | INFO | WARN | ERROR
# (default INFO). This is a COLLECTION-SIDE filter, not daemon verbosity: CLI
# 0.8.0's `multica daemon start` has no --log-level flag/env and always writes
# DEBUG records to ~/.multica/daemon.log. Kept for `docker logs` noise control.
MULTICA_LOG_LEVEL=INFO
