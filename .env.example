# Placeholder env for local/compose smoke. Do not put real secrets in git.
# Daemon Ready requires all three secret classes below (hard-fail if missing).

# Multica daemon auth (required)
MULTICA_TOKEN=
MULTICA_SERVER_URL=https://api.multica.ai
MULTICA_APP_URL=https://multica.ai
MULTICA_WORKSPACE_ID=
MULTICA_DAEMON_ID=multica-runtime
MULTICA_AGENT_RUNTIME_NAME=multica-runtime

# Cursor agent (v1 provider; required)
CURSOR_API_KEY=

# Git HTTPS auth for Multica lazy repo checkout (at least one forge token required)
GITHUB_TOKEN=

# Optional forge hosts (hostname only, no scheme)
# GITLAB_TOKEN=
# GITLAB_HOST=gitlab.com
# GITEA_TOKEN=
# GITEA_HOST=
# GITEA_USER=oauth2

# Configurable workspaces root (PVC / compose volume mount point)
MULTICA_WORKSPACES_ROOT=/home/agent/workspaces
