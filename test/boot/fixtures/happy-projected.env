# Happy-path with Secret projection mounts — no MULTICA_TOKEN / CURSOR_API_KEY /
# GITHUB_TOKEN in env; those come from /run/secrets/* file mounts.
MULTICA_AGENT_RUNTIME_NAME=multica-runtime-boot-seam-projected
MULTICA_WORKSPACES_ROOT=/home/agent/workspaces
MULTICA_HOME_SECRET_DIR=/run/secrets/multica-home
CURSOR_API_KEY_FILE=/run/secrets/cursor/CURSOR_API_KEY
GITHUB_TOKEN_FILE=/run/secrets/git/GITHUB_TOKEN
