MULTICA_AGENT_CLI=cursor,claude
CURSOR_API_KEY=cursor_boot_seam_fixture
ANTHROPIC_API_KEY=sk-ant-boot_seam_fixture
GITHUB_TOKEN=ghp_boot_seam_fixture
MULTICA_DAEMON_ID=multica-runtime-boot-seam-both
MULTICA_AGENT_RUNTIME_NAME=multica-runtime-boot-seam-both
MULTICA_WORKSPACES_ROOT=/home/agent/workspaces
