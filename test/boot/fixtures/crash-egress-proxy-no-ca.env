# Crash fixture: egress control requested but no proxy CA mounted.
# MULTICA_EGRESS_PROXY=iron-proxy means "route through a MITM proxy and trust its
# CA"; a missing CA must fail closed (CrashLoop), never silently fall back to
# direct egress and never skip TLS verification.
MULTICA_TOKEN=mul_boot_seam_fixture
CURSOR_API_KEY=cursor_boot_seam_fixture
GITHUB_TOKEN=ghp_boot_seam_fixture
MULTICA_EGRESS_PROXY=iron-proxy
MULTICA_EGRESS_PROXY_CA=/run/certs/iron-proxy/ca.crt
