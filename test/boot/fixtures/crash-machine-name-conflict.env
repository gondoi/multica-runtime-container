# MULTICA_MACHINE_NAME and its native alias MULTICA_DAEMON_DEVICE_NAME are the
# same knob — conflicting values must be a hard boot failure (step 1b), not a
# silent pick. Everything else is a complete happy-path credential set so the
# failure can only come from the name check.
MULTICA_TOKEN=mul_boot_seam_fixture
CURSOR_API_KEY=cursor_boot_seam_fixture
GITHUB_TOKEN=ghp_boot_seam_fixture
MULTICA_DAEMON_ID=multica-runtime-boot-seam
MULTICA_MACHINE_NAME=fuel-general
MULTICA_DAEMON_DEVICE_NAME=personal
