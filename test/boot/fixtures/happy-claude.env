# Happy-path fixture for the Claude Code harness with Secret projection:
# no ANTHROPIC_API_KEY / GITHUB_TOKEN / CURSOR_API_KEY in env — those come from
# /run/secrets/* file mounts. MULTICA_AGENT_CLI=claude means a Cursor key is
# neither mounted nor required.
MULTICA_AGENT_RUNTIME_NAME=multica-runtime-boot-seam-claude
MULTICA_WORKSPACES_ROOT=/home/agent/workspaces
MULTICA_AGENT_CLI=claude
MULTICA_HOME_SECRET_DIR=/run/secrets/multica-home
ANTHROPIC_API_KEY_FILE=/run/secrets/claude/ANTHROPIC_API_KEY
GITHUB_TOKEN_FILE=/run/secrets/git/GITHUB_TOKEN
