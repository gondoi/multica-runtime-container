# Happy-path with GitHub Enterprise Server password auth — the lowest-priority
# tier (App > PAT > password). GITHUB_USER/GITHUB_PASSWORD/GITHUB_HOST come from
# projected Secret files, not env, to exercise materialize-secrets.sh too.
# Multica identity + Cursor key also come from /run/secrets/* mounts. No git
# Secret dir is mounted, so no GITHUB_TOKEN competes with the password tier.
MULTICA_AGENT_RUNTIME_NAME=multica-runtime-boot-seam-password
MULTICA_WORKSPACES_ROOT=/home/agent/workspaces
MULTICA_HOME_SECRET_DIR=/run/secrets/multica-home
CURSOR_API_KEY_FILE=/run/secrets/cursor/CURSOR_API_KEY
GITHUB_HOST_FILE=/run/secrets/git-password/GITHUB_HOST
GITHUB_USER_FILE=/run/secrets/git-password/GITHUB_USER
GITHUB_PASSWORD_FILE=/run/secrets/git-password/GITHUB_PASSWORD
