# Happy-path fixture for the OpenAI Codex harness.
# Codex authenticates from $CODEX_HOME/auth.json, NOT from OPENAI_API_KEY
# (verified against codex-cli 0.167.0), so this fixture exists to prove the
# entrypoint projects the env key into ~/.codex/auth.json (0600) before the
# daemon starts. No Cursor/Anthropic credential: MULTICA_AGENT_CLI=codex means
# neither is required.
MULTICA_TOKEN=mul_boot_seam_fixture
MULTICA_AGENT_CLI=codex
OPENAI_API_KEY=sk-codex-boot_seam_fixture
GITHUB_TOKEN=ghp_boot_seam_fixture
MULTICA_DAEMON_ID=multica-runtime-boot-seam-codex
MULTICA_AGENT_RUNTIME_NAME=multica-runtime-boot-seam-codex
MULTICA_WORKSPACES_ROOT=/home/agent/workspaces
