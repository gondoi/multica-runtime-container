# Happy-path fixture for a Secret-projected Codex login (auth.json mount).
# Mirrors the K8s/compose contract: no OPENAI_API_KEY in env — the login file
# created by `codex login` (API key or ChatGPT OAuth) arrives as a file mount
# and the entrypoint projects it into $CODEX_HOME/auth.json.
MULTICA_TOKEN=mul_boot_seam_fixture
MULTICA_AGENT_CLI=codex
CODEX_AUTH_JSON_FILE=/run/secrets/codex/auth.json
GITHUB_TOKEN=ghp_boot_seam_fixture
MULTICA_DAEMON_ID=multica-runtime-boot-seam-codex-proj
MULTICA_AGENT_RUNTIME_NAME=multica-runtime-boot-seam-codex-proj
MULTICA_WORKSPACES_ROOT=/home/agent/workspaces
